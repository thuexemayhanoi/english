---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/articles/' | absolute_url }}</loc></url>
  <url><loc>{{ '/search/' | absolute_url }}</loc></url>
  <url><loc>{{ '/about/' | absolute_url }}</loc></url>
  {% for a in site.articles %}
  <url><loc>{{ a.url | absolute_url }}</loc><lastmod>{{ a.last_reviewed }}</lastmod></url>
  {% endfor %}
</urlset>
